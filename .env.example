# Copy to .env and fill in. Never put real keys in this file.

# Frontend (browser) — from Supabase: Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (Vercel env vars for /api/send-followups) — never prefix with VITE_
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Project Settings > API > service_role (secret)
RESEND_API_KEY=re_your_resend_key
FOLLOWUP_FROM_EMAIL=Bench Tracker <followups@yourcompany.com>
CRON_SECRET=generate-with-openssl-rand-hex-32

# Show the Create account tab on the login page (set to false to hide it)
VITE_ALLOW_SIGNUP=true
